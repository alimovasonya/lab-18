
#include <stdio.h>

typedef struct {
    int width;
    int height;
} Rectangle;

long long area(Rectangle r) {
    return (long long)r.width * r.height;
}

long long perimeter(Rectangle r) {
    return 2LL * (r.width + r.height);
}

int main(void) {
    Rectangle rect;

    printf("Enter width and height: ");

    if (scanf("%d %d", &rect.width, &rect.height) != 2) {
        printf("Error: invalid input\n");
        return 1;
    }

    if (rect.width < 1 || rect.width > 1000 ||
        rect.height < 1 || rect.height > 1000) {
        printf("Error: dimensions must be from 1 to 1000\n");
        return 1;
    }

    printf("Area: %lld\n", area(rect));
    printf("Perimeter: %lld\n", perimeter(rect));

    return 0;
}
